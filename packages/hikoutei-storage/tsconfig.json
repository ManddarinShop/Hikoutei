{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    // P8-D2 phase 1 transitional: the moved storage/persistence trees keep
    // imports into the root src tree (application/*, api/*,
    // shared/observability/*) via the "@hikoutei-app-src/*" specifier until
    // P8-D2 phase 2 severs them. The paths targets are root-src SOURCES, so
    // those files join this program and rootDir must cover the repo root
    // (emitted layout dist/packages/hikoutei-storage/src/**).
    // Emitted layout is therefore dist/packages/hikoutei-storage/src/** (the
    // useful subtree, referenced by `exports`), with a transient
    // dist/src/** emission of reached-in root-src modules that is never
    // shipped (private package; the root dist bundle is the only consumer).
    "rootDir": "../..",
    "outDir": "dist",
    "baseUrl": "../..",
    "paths": {
      // Transitional bridge (P8-D2 phase 2 removes): the moved files keep
      // imports into root src as a package specifier that every tsconfig in
      // the repo maps back onto the root src tree (single type identity —
      // a d.ts copy would clash with the compiling sources).
      "@hikoutei-app-src/*": ["src/*"],
      // Hermetic self/cross maps: the reached-in root-src files import the
      // moved packages back by name; mapping both to source (never dist)
      // removes any build-order dependency between the two packages.
      "@hikoutei/storage/*": ["packages/hikoutei-storage/src/*"],
      "@hikoutei/sheets/*": ["packages/hikoutei-sheets/src/*"]
    },
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}