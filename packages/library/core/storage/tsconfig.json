{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    // P8-D2 phase 2 cycle break: storage sits BELOW the sync engine in the
    // DAG and imports contracts/ikisaki plus its own trees only — the former
    // "@hikoutei/sync-engine/*" source cross-map (the transitional bridge)
    // is gone with the storage->engine imports. The mapped flush/observation/
    // projection/conflict persistence glue now lives in this package under
    // src/orm + src/sync, so the emission layout is
    // dist/packages/library/core/storage/src/**.
    "rootDir": "../../../..",
    "outDir": "dist",
    "baseUrl": "../../../..",
    "paths": {
      // Hermetic self map: reached-in root-src files import this package back
      // by name; mapping to source (never dist) removes any build-order
      // dependency.
      "@hikoutei/storage/*": ["packages/library/core/storage/src/*"]
    },
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}