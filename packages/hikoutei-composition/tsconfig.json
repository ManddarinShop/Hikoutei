{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    // P8-D2 phase 2: composition may name every leaf, and it cross-maps the
    // leaf SOURCES (same hermetic no-build-order trick as the storage/sheets/
    // engine tsconfigs): the transient reached-in mirrors in this package's
    // dist are never bundled or shipped. Nothing here reaches into the root
    // package (composition -> engine -> storage is the only direction).
    "rootDir": "../..",
    "outDir": "dist",
    "baseUrl": "../..",
    "paths": {
      "@hikoutei/storage/*": ["packages/hikoutei-storage/src/*"],
      "@hikoutei/sheets/*": ["packages/hikoutei-sheets/src/*"],
      "@hikoutei/sync-engine/*": ["packages/hikoutei-sync-engine/src/*"]
    },
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
