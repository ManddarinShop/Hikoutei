{
  "name": "@hikoutei/sheets",
  "version": "0.1.0",
  "description": "Google Sheets sync adapter leaf for the Hikoutei typed repository: the google-sheets-api provider (P8-D2 phase 1).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ManddarinShop/Hikoutei.git",
    "directory": "packages/hikoutei-sheets"
  },
  "bugs": {
    "type": "git",
    "url": "https://github.com/ManddarinShop/Hikoutei/issues"
  },
  "homepage": "https://github.com/ManddarinShop/Hikoutei#readme",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "exports": {
    "./*.js": {
      "types": "./dist/packages/hikoutei-sheets/src/*.d.ts",
      "import": "./dist/packages/hikoutei-sheets/src/*.js"
    },
    "./*": {
      "types": "./dist/packages/hikoutei-sheets/src/*.d.ts",
      "import": "./dist/packages/hikoutei-sheets/src/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@googleapis/sheets": "^14.0.0",
    "@hikoutei/contracts": "0.1.0",
    "google-auth-library": "^11.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  }
}