{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "hikoutei": ["../../src/index.ts"],
      "hikoutei/internal/sync-status": ["../../src/internal/syncStatus.ts"],
      "@hikoutei-app-src/*": ["../../src/*"],
      // P8-D2 phase 1: root src now imports the moved storage/sheets leaves by
      // package specifier; map them to source so this program stays hermetic.
      "@hikoutei/storage/*": ["../../packages/hikoutei-storage/src/*"],
      "@hikoutei/sheets/*": ["../../packages/hikoutei-sheets/src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "../../src/types/**/*.d.ts"
  ]
}
