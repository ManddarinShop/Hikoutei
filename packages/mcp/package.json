{
  "name": "spreadsheet-db-mcp",
  "version": "0.1.0",
  "description": "stdio MCP server exposing a SQLite-authoritative entity database with an async Google Sheets projection to AI agents.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ManddarinShop/Hikoutei.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/ManddarinShop/Hikoutei/issues"
  },
  "homepage": "https://github.com/ManddarinShop/Hikoutei#readme",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "spreadsheet-db-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "google-sheets",
    "sqlite",
    "hikoutei",
    "claude",
    "cursor"
  ],
  "license": "MIT",
  "dependencies": {
    "@mikro-orm/core": "7.1.7",
    "@mikro-orm/sql": "7.1.7",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "hikoutei": "0.9.33-dev.4"
  }
}
