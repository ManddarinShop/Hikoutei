diff --git a/packages/ikisaki/test/support/node-sqlite.d.ts b/packages/ikisaki/test/support/node-sqlite.d.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b62d73cdd1fb94918579dc35d61f4ac9a7b494fc
--- /dev/null
+++ b/packages/ikisaki/test/support/node-sqlite.d.ts
@@ -0,0 +1,39 @@
+/**
+ * Minimal ambient typing for the `node:sqlite` built-in used by the kernel
+ * test adapter.
+ *
+ * The historical recovery environment resolves `@types/node@20.19`, which
+ * predates `node:sqlite` (Node 22.5+) and ships no `sqlite.d.ts`; without
+ * this declaration `tsc -p tsconfig.test.json` fails on
+ * `nodeSqliteAdapter.ts`, which imports the built-in. When the package
+ * resolves a newer `@types/node` that already types `node:sqlite`, the two
+ * ambient module declarations merge and `skipLibCheck` suppresses any
+ * overlap — the shim is otherwise inert. It covers only the surface the
+ * test adapter touches. This file should be deleted when the package's
+ * minimum `@types/node` ships real `node:sqlite` types.
+ */
+
+declare module "node:sqlite" {
+  /** Value accepted as a bound SQL parameter. */
+  type SQLInputValue = string | number | bigint | boolean | Uint8Array | null | undefined;
+
+  /** Prepared statement; results are `unknown` and narrowed by callers. */
+  interface StatementSync {
+    all(...anonymousParameters: unknown[]): unknown[];
+    get(...anonymousParameters: unknown[]): unknown;
+    run(...anonymousParameters: unknown[]): { changes: number | bigint; lastInsertRowid: number | bigint };
+  }
+
+  /** Options accepted by the `DatabaseSync` constructor. */
+  interface DatabaseSyncOptions {
+    enableForeignKeyConstraints?: boolean;
+  }
+
+  /** Synchronous SQLite connection over the Node built-in. */
+  class DatabaseSync {
+    constructor(location: string, options?: DatabaseSyncOptions);
+    prepare(sql: string): StatementSync;
+    exec(sql: string): void;
+    close(): void;
+  }
+}
