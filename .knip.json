{
  "$schema": "https://unpkg.com/knip@6.33.0/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/api/index.ts",
        "test/**/*.{ts,mts,cts}",
        "scripts/**/*.{ts,mts,mjs}"
      ],
      "project": [
        "src/**/*.ts",
        "test/**/*.{ts,mts}",
        "scripts/**/*.{ts,mts,mjs}"
      ]
    },
    "packages/protocol/ikisaki": {
      "entry": [
        "test/**/*.ts"
      ],
      "project": [
        "src/**/*.ts",
        "test/**/*.ts"
      ]
    },
    "packages/mcp": {
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/library/core/storage": {
      "entry": [
        "src/**/*.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/library/cloud/sheets": {
      "entry": [
        "src/**/*.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/library/core/sync-engine": {
      "entry": [
        "src/**/*.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/library/core/composition": {
      "entry": [
        "src/**/*.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/library/cloud/cli": {
      "entry": [
        "src/**/*.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    }
  },
  "ignore": [],
  "ignoreBinaries": [
    "mkfifo"
  ],
  "ignoreExportsUsedInFile": true,
  "tags": [
    "-lint-ignore"
  ]
}
