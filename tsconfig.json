{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "rootDir": "src",
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      // The @hikoutei/ikisaki workspace package must be built first
      // (`npm run build -w @hikoutei/ikisaki`) so this declaration file
      // exists before the root typecheck runs; the root npm scripts do this
      // as a prebuild step.
      //
      // @hikoutei/contracts deliberately has NO paths entry here: this
      // config must stay an emit-compatible program (rootDir src, include
      // src) because it drives `npm run build` and the in-memory
      // declaration-emit audit (test/hikoutei-public-surface-audit.test.ts).
      // The leaf resolves through node_modules (workspace link + package
      // exports -> its own dist, built first by the build scripts).
      // Source-based contract compilation lives in tsconfig.test.json and
      // the vitest alias, so typecheck/test never depend on a stale dist.
      "@hikoutei/ikisaki": ["./packages/ikisaki/dist/index.d.ts"]
    },
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}