# Env-driven sync auto-start: set the spreadsheet URL and the library starts
# the Sheets sync internally on createTypedSheets() — flush() then flows to
# Google Sheets through the outbox worker automatically. Leave unset for
# local-only SQLite mode.
HIKOUTEI_SYNC_SPREADSHEET_URL=https://docs.google.com/spreadsheets/d/your-spreadsheet-id/edit
# Service-account key file path (ADC standard).
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# Optional intervals (ms):
# HIKOUTEI_SYNC_POLLING_INTERVAL_MS=60000
# HIKOUTEI_SYNC_FULL_SCAN_INTERVAL_MS=60000
