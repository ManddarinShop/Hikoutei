{
  "name": "hikoutei",
  "version": "0.3.4",
  "description": "Hikoutei — typed repository and safe write layer for Google Sheets-backed MVPs.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ManddarinShop/Hikoutei.git"
  },
  "bugs": {
    "url": "https://github.com/ManddarinShop/Hikoutei/issues"
  },
  "homepage": "https://github.com/ManddarinShop/Hikoutei#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "apps-script/gateway/Code.gs",
    "apps-script/gateway/appsscript.json"
  ],
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "vitest run test/*.test.ts"
  },
  "keywords": [
    "google-sheets",
    "typescript",
    "repository",
    "optimistic-locking"
  ],
  "license": "MIT",
  "dependencies": {
    "@googleapis/sheets": "^14.0.0",
    "@hikoutei/kohkai": "0.1.0",
    "google-auth-library": "^11.0.0"
  },
  "devDependencies": {
    "@mikro-orm/core": "7.1.7",
    "@mikro-orm/sql": "7.1.7",
    "@types/node": "^20.14.10",
    "typescript": "^5.5.3",
    "vitest": "^1.6.0"
  },
  "peerDependencies": {
    "@mikro-orm/core": "7.1.7",
    "@mikro-orm/sql": "7.1.7"
  },
  "peerDependenciesMeta": {
    "@mikro-orm/core": {
      "optional": true
    },
    "@mikro-orm/sql": {
      "optional": true
    }
  }
}
