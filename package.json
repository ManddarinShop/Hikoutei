{
  "name": "typed-sheets",
  "version": "0.1.0",
  "description": "Typed repository and safe write layer for Google Sheets-backed MVPs.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./orm": {
      "types": "./dist/orm/index.d.ts",
      "import": "./dist/orm/index.js"
    },
    "./mikro-orm": {
      "types": "./dist/adapter/mikro-orm/index.d.ts",
      "import": "./dist/adapter/mikro-orm/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "apps-script/gateway/Code.gs"
  ],
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "vitest run test/*.test.ts"
  },
  "keywords": [
    "google-sheets",
    "typescript",
    "repository",
    "optimistic-locking"
  ],
  "license": "MIT",
  "devDependencies": {
    "@mikro-orm/core": "7.1.7",
    "@mikro-orm/sql": "7.1.7",
    "@types/node": "^20.14.10",
    "typescript": "^5.5.3",
    "vitest": "^1.6.0"
  },
  "peerDependencies": {
    "@mikro-orm/core": "7.1.7",
    "@mikro-orm/sql": "7.1.7"
  },
  "peerDependenciesMeta": {
    "@mikro-orm/core": {
      "optional": true
    },
    "@mikro-orm/sql": {
      "optional": true
    }
  }
}
