# Env-driven sync auto-start: set the spreadsheet URL and createTypedSheets()
# starts the Sheets sync internally (flush() flows to Google Sheets through
# the outbox worker). Leave unset for local-only SQLite mode.
HIKOUTEI_SYNC_SPREADSHEET_URL=https://docs.google.com/spreadsheets/d/your-spreadsheet-id/edit
# Optional intervals (ms): HIKOUTEI_SYNC_POLLING_INTERVAL_MS, HIKOUTEI_SYNC_FULL_SCAN_INTERVAL_MS
# Optional request-start pacing (ms) for the direct provider's read/write limiters.
# Provider default (absent): 800 ms; the env override must be between 2,000 and 9,999 ms.
# HIKOUTEI_SYNC_RATE_LIMIT_INTERVAL_MS=2000
# Default SQLite database path for createTypedSheets() and the adopt CLI when
# `dbName` is omitted. Defaults to ./hikoutei.sqlite.
# HIKOUTEI_DB_PATH=./hikoutei.sqlite
# Internal file logger. HIKOUTEI_LOG_FILE is the target log file; absent or
# blank disables file logging entirely. LOG_LEVEL is debug|info|warn|error
# (default info). LOG_MAX_BYTES is the rotation threshold in bytes
# (default 10485760 = 10 MiB, minimum 4096). LOG_BACKUPS is the number of
# rotated backup files kept (default 5, minimum 0).
# HIKOUTEI_LOG_FILE=./hikoutei.log
# HIKOUTEI_LOG_LEVEL=info
# HIKOUTEI_LOG_MAX_BYTES=10485760
# HIKOUTEI_LOG_BACKUPS=5
# Explicit path to the MCP server's hikoutei.config.json entity declaration.
# Search order: --config flag, this env var, then ./hikoutei.config.json.
# HIKOUTEI_MCP_CONFIG=/absolute/path/to/hikoutei.config.json

# Service account used by the full direct sync provider (googleSheetsApi) and
# the opt-in Direct Sheets API experiments. The account must be shared on the
# spreadsheet. ADC (Application Default Credentials) reads this path automatically.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# Opt-in Direct Sheets API benchmark (scripts/bench/direct-sheets-api-service-account.mjs)
# and the service-account-only live sync scenario
# (scripts/ci/run-api-scenario.mjs --backend live). The
# service account from GOOGLE_APPLICATION_CREDENTIALS must be shared on this
# spreadsheet.
GOOGLE_SHEETS_TEST_SPREADSHEET_ID=your-spreadsheet-id
# Opt-in Direct Sheets API batch-write benchmark (scripts/bench/direct-sheets-api-batch-update.mjs)
# Optional knobs (defaults shown): DIRECT_BATCH_TAB_COUNTS=1,2,4,10,20
# DIRECT_BATCH_TOTAL_ROWS=10000 DIRECT_BATCH_WARMUP=1 DIRECT_BATCH_REPETITIONS=3
# DIRECT_BATCH_SEED=20260804 (deterministic scenario-order shuffle seed)
