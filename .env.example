GOOGLE_SPREADSHEET_URL=https://docs.google.com/spreadsheets/d/your-spreadsheet-id/edit
GOOGLE_SHEET_NAME=Users
# Service account used by the full direct sync provider (googleSheetsApi) and
# the opt-in Direct Sheets API experiments. The account must be shared on the
# spreadsheet. ADC (Application Default Credentials) reads this path automatically.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
GOOGLE_SERVICE_ACCOUNT_SHEET_NAME=Users
# Opt-in Direct Sheets API benchmark (scripts/bench/direct-sheets-api-service-account.mjs)
# and the service-account-only live sync scenario
# (scripts/ci/run-api-scenario.mjs --backend live --outbound direct). The
# service account from GOOGLE_APPLICATION_CREDENTIALS must be shared on this
# spreadsheet. The service-account-only path never reads the Apps Script
# gateway secrets below.
GOOGLE_SHEETS_TEST_SPREADSHEET_ID=your-spreadsheet-id
# Opt-in Direct Sheets API batch-write benchmark (scripts/bench/direct-sheets-api-batch-update.mjs)
# Optional knobs (defaults shown): DIRECT_BATCH_TAB_COUNTS=1,2,4,10,20
# DIRECT_BATCH_TOTAL_ROWS=10000 DIRECT_BATCH_WARMUP=1 DIRECT_BATCH_REPETITIONS=3
# DIRECT_BATCH_SEED=20260804 (deterministic scenario-order shuffle seed)
GOOGLE_APPS_SCRIPT_GATEWAY_URL=https://script.google.com/macros/s/your-deployment-id/exec
GOOGLE_APPS_SCRIPT_GATEWAY_SECRET=your-gateway-secret
GOOGLE_APPS_SCRIPT_GATEWAY_SHEET_NAME=Users
# Legacy Apps Script gateway secrets (deployments without a service account;
# the live scenario in service-account-only mode does not use these):
# TYPED_SHEETS_GATEWAY_URL=...
# TYPED_SHEETS_GATEWAY_SHARED_SECRET=...
# TYPED_SHEETS_GATEWAY_SHEET_ID=...
# The app-side bootstrap reads the GOOGLE_APPS_SCRIPT_* form above.
