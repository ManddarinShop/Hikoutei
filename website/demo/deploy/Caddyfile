# Caddy reverse proxy for the Hikoutei live demo (docker compose).
#
#   /            -> 302 -> /demo (the VitePress demo page)
#   /api/*       -> demo-server container (SSE streams unbuffered)
#   everything   -> VitePress static build (DOCS_BASE_PATH=/, mounted /srv/docs)
#
# Domain front: Caddy obtains/renews the TLS certificate automatically
# (HTTP-01 via Cloudflare proxy) and redirects :80 to https.

hikoutei.cloud {
	# Bare host root -> live demo
	redir / /demo 302

	# Demo backend (SSE: Caddy streams responses without buffering)
	handle /api/* {
		reverse_proxy demo-server:3101
	}

	# Static docs + demo
	# Static docs + demo (VitePress pretty URLs: /demo -> demo.html)
	handle {
		root * /srv/docs
		try_files {path} {path}.html {path}/ /404.html
		file_server
	}
}