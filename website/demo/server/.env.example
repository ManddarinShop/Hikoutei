# Hikoutei sync auto-start: set both values to run the demo with live
# Google Sheets projection. Leave unset for local-only SQLite mode —
# every other endpoint (burst, stream, metrics) works identically.
HIKOUTEI_SYNC_SPREADSHEET_URL=https://docs.google.com/spreadsheets/d/your-demo-spreadsheet-id/edit
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/demo-service-account.json

# Demo server port (default 3101)
# PORT=3101
# Demo SQLite database path (default ./demo.sqlite)
# DEMO_DB_PATH=./demo.sqlite